IDI_ICON1 ICON "@APP_ICON@"

1 VERSIONINFO
FILEVERSION @MALAMIH_VERSION_COMMAS@,0
PRODUCTVERSION @MALAMIH_VERSION_COMMAS@,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Malamih - Offline face recognition"
            VALUE "ProductName", "Malamih"
            VALUE "FileVersion", "@MALAMIH_VERSION@"
            VALUE "ProductVersion", "@MALAMIH_VERSION@"
            VALUE "OriginalFilename", "Malamih.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
